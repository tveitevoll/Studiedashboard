BEGIN:VEVENT
UID:utd-MSH-SH4100-20260817-fysisksamlingcampusporsg@playful-naiad-32224f.netlify.app
DTSTAMP:20260804T120000Z
SUMMARY:MSH-SH4100 – Fysisk samling\, campus Porsgrunn
DESCRIPTION:17.8: 09.15 åpning og velkommen (Knut Tore Sælør) + presentasjon av studieprogrammet (Ausland/Meum)\; 10.15 samfunn og helse – perspektiver fra studieretningene\; 13.15 bli kjent og gjennomgang av arbeidskrav (studieretningsvis). 18.8: 09.15 Den nordiske velferdsstaten – har den en fremtid? (Halvard Vike)\; 13.15 inndeling i grupper og arbeid med arbeidskrav. 19.8: 09.15 akademisk skriving (Susanne og Knut Tore)\; 10.15 formulering av problemstilling\; 13.15 litteratursøk-workshop (bibliotekar og faglærere). 20.8: 09.15 introduksjon til KI og læring (Ingelill SB Eide)\; 10.15 sosial ulikhet i helse (Steffen Torp)\; 13.15 arbeid med arbeidskrav og eksamen\; 14.15 oppsummering og evaluering.
DTSTART;VALUE=DATE:20260817
DTEND;VALUE=DATE:20260821
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:MSH-SH4100 – Fysisk samling\, campus Porsgrunn
TRIGGER:-P1D
END:VALARM
END:VEVENT
